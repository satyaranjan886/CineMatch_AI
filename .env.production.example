# Production environment template.
# Copy to `.env.production` on the server and fill values offline.
# NEVER commit `.env.production` or real secrets.

DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
SECURE_SSL_REDIRECT=true
JWT_REFRESH_COOKIE_SECURE=true
# HSTS (seconds). Set 0 only while validating TLS; production default is 31536000.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# Metrics scrape protection (Prometheus). Prefer a scrape token + private network.
METRICS_ENABLED=true
METRICS_SCRAPE_TOKEN=replace-with-long-random-metrics-token
METRICS_ALLOW_PRIVATE_NETWORK=true
# Set true to require the bearer token even from private networks.
METRICS_REQUIRE_TOKEN=false

# Nginx TLS (on-box). When false, terminate TLS at ALB/Cloudflare and keep SECURE_SSL_REDIRECT=true.
TLS_ENABLED=false
SERVER_NAME=app.example.com
# TLS_CERT_HOST_PATH=/etc/cinematch/certs/fullchain.pem
# TLS_KEY_HOST_PATH=/etc/cinematch/certs/privkey.pem

# Database — supply via secrets manager / host env. Do not paste production passwords into git.
POSTGRES_DB=cinematch
POSTGRES_USER=cinematch
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgres://cinematch:replace-me@postgres:5432/cinematch
# Compose Postgres on the same host usually has no TLS → prefer.
# Managed RDS / public network paths should use require.
DATABASE_SSLMODE=prefer

# Collaborative filtering artifacts (absolute path required in production)
CF_MODEL_ARTIFACT_DIR=/app/collaborative_models
# Durable S3 prefix + sync (multi-AZ). Leave sync false for single-host shared volume.
# CF_ARTIFACT_URI_PREFIX=s3://cinematch-models/cf
# CF_ARTIFACT_SYNC_ENABLED=true
# AWS_DEFAULT_REGION=us-east-1
# AWS_STORAGE_BUCKET_NAME=cinematch-media

# Cache soft-fail (production default true when using production settings)
CACHE_IGNORE_EXCEPTIONS=true

# Observability (Gunicorn multiprocess)
PROMETHEUS_MULTIPROC_DIR=/tmp/cinematch-prometheus

# Redis (password required in production settings)
REDIS_PASSWORD=replace-me
REDIS_URL=redis://:replace-me@redis:6379/0
CELERY_BROKER_URL=redis://:replace-me@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-me@redis:6379/2
REDIS_HEALTH_REQUIRED=true

# Frontend
NEXT_PUBLIC_API_URL=https://app.example.com
API_INTERNAL_URL=http://backend:8000

# JWT / cookies
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_REFRESH_COOKIE_SAMESITE=Lax
JWT_REFRESH_COOKIE_SECURE=true

# Observability
METRICS_ENABLED=true
# Optional shared scrape token for Prometheus (also used in production).
# METRICS_SCRAPE_TOKEN=
METRICS_ALLOW_PRIVATE_NETWORK=true
METRICS_REQUIRE_TOKEN=false
# PROMETHEUS_MULTIPROC_DIR=/tmp/cinematch-prometheus

# Gunicorn (optional overrides)
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=60
