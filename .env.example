# CineMatch AI — environment template
# Copy to .env and adjust. Never commit real secrets.

DJANGO_SETTINGS_MODULE=config.settings.development

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=false
# Keep HSTS disabled for local HTTP:
# SECURE_HSTS_SECONDS=0

# Local Homebrew Postgres (no password, current OS user):
# DATABASE_URL=postgres://127.0.0.1:5432/cinematch
# Docker Compose Postgres (defaults match docker-compose.yml):
POSTGRES_DB=cinematch
POSTGRES_USER=cinematch
POSTGRES_PASSWORD=cinematch-local-only
DATABASE_URL=postgres://cinematch:cinematch-local-only@localhost:5432/cinematch
DB_CONN_MAX_AGE=60

# Homebrew Redis (no auth): redis://127.0.0.1:6379/0
# Docker Compose Redis (password required):
REDIS_PASSWORD=cinematch-local-redis
REDIS_URL=redis://:cinematch-local-redis@127.0.0.1:6379/0
CELERY_BROKER_URL=redis://:cinematch-local-redis@127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://:cinematch-local-redis@127.0.0.1:6379/2

# Production also requires:
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# DATABASE_SSLMODE=require
# JWT_REFRESH_COOKIE_SECURE=true
# SECURE_SSL_REDIRECT=true
# METRICS_SCRAPE_TOKEN=<long-random>
# TLS_ENABLED=true (on-box) or terminate TLS at ALB with TLS_ENABLED=false

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_REFRESH_COOKIE_SAMESITE=Lax
JWT_REFRESH_COOKIE_SECURE=false

# Frontend (Next.js). Browser traffic uses /backend-api rewrite; this is the upstream.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://127.0.0.1:8000

# Ranking weights (hybrid home).
REC_WEIGHT_COLLABORATIVE=0.30
REC_WEIGHT_CONTENT=0.25
REC_WEIGHT_GENRE_PREFERENCE=0.15
REC_WEIGHT_POPULARITY=0.10
REC_WEIGHT_TRENDING=0.10
REC_WEIGHT_FRESHNESS=0.05
REC_WEIGHT_AFFINITY=0.05

# Popularity & trending (Phase 5)
RECOMMENDATION_POPULAR_CACHE_TTL=900
RECOMMENDATION_TRENDING_CACHE_TTL=300
RECOMMENDATION_MIN_VOTES_PRIOR=10
RECOMMENDATION_TRENDING_DEFAULT_WINDOW_HOURS=24
RECOMMENDATION_TRENDING_HALF_LIFE_HOURS=24
RECOMMENDATION_TRENDING_WINDOWS_HOURS=24,168

# Content-based similarity (Phase 6)
CONTENT_SIMILARITY_MAX_FEATURES=5000
CONTENT_PROFILE_LIKE_WEIGHT=3.0
CONTENT_PROFILE_RATING_WEIGHT=2.5
CONTENT_PROFILE_COMPLETE_WEIGHT=2.0
CONTENT_PROFILE_HISTORY_WEIGHT=1.0
CONTENT_PROFILE_MIN_RATING=7.0

# Collaborative filtering (Phase 7)
CF_MIN_USER_INTERACTIONS=3
CF_ALS_FACTORS=64
CF_ALS_ITERATIONS=15
CF_ALS_REGULARIZATION=0.01
CF_ALS_RANDOM_STATE=42
CF_EVAL_AT_K=10
CF_MODEL_ARTIFACT_DIR=collaborative_models
# Production must use an absolute shared path, e.g. /app/collaborative_models

# Offline evaluation (temporal)
EVAL_K_VALUES=5,10,20
EVAL_MIN_USERS=5
EVAL_MIN_TEST_INTERACTIONS=10
EVAL_MIN_INTERACTIONS=2
EVAL_RANDOM_SEED=42
EVAL_USE_CATALOG_PRIOR=false
RECOMMENDATION_COLLABORATIVE_CACHE_TTL=600
CF_WEIGHT_WATCH_COMPLETE=5.0
CF_WEIGHT_LIKE=4.0
CF_WEIGHT_RATING=3.0
CF_WEIGHT_WATCH_PROGRESS=2.0
CF_WEIGHT_WATCHLIST_ADD=1.5

# Hybrid home / caches
HYBRID_HOME_CACHE_TTL=600
MOVIE_DETAIL_CACHE_TTL=600
SEMANTIC_SEARCH_CACHE_TTL=120
HOME_PRECOMPUTE_LOOKBACK_HOURS=24
HOME_PRECOMPUTE_USER_LIMIT=200
INTERACTION_METADATA_MAX_BYTES=4096

# Observability
METRICS_ENABLED=true
# Production should keep Redis required. Local pytest sets this false unless USE_REDIS_CACHE=1.
REDIS_HEALTH_REQUIRED=true
# Optional for multi-worker Gunicorn metric aggregation:
# PROMETHEUS_MULTIPROC_DIR=/tmp/cinematch-prometheus

# Locust load testing (local/staging only — never public production)
# DJANGO_SETTINGS_MODULE=config.settings.loadtest
# See loadtests/README.md

# Multi-AZ / S3 artifact sync (production)
# CF_ARTIFACT_URI_PREFIX=s3://cinematch-models/cf
# CF_ARTIFACT_SYNC_ENABLED=true
# CACHE_IGNORE_EXCEPTIONS=true
# AWS_DEFAULT_REGION=us-east-1
